#!/bin/bash

# Resolve Auth: maps AUTH_TYPE + the environment dimension to the per-environment
# Cognito user pool / AVP policy store configured on the agent.
#
# Sourced by build_context (legacy routes-on-service model), build_service_context
# and build_link_context.
#
# Required:
#   AUTH_TYPE      - "aws-cognito" or "aws-avp" (agent env)
#   ENV_DIMENSION  - value of the "environment" dimension, e.g. "dev"
# Exports: AUTH_TYPE, COGNITO_USER_POOL_ARN, AVP_POLICY_STORE_ARN, AVP_POLICY_STORE_ID

: "${AUTH_TYPE:?AUTH_TYPE is required}"

ENV_SUFFIX=$(echo "${ENV_DIMENSION:-}" | tr '[:lower:]' '[:upper:]' | tr '-' '_')
: "${ENV_SUFFIX:?service.dimensions.environment is required}"

case "$AUTH_TYPE" in
  aws-avp)
    : "${OPA_PROVIDER_NAME:?OPA_PROVIDER_NAME is required when AUTH_TYPE=aws-avp}"
    AVP_VAR="AVP_POLICY_STORE_ARN_${ENV_SUFFIX}"
    : "${!AVP_VAR:?${AVP_VAR} is required when AUTH_TYPE=aws-avp}"
    AVP_POLICY_STORE_ARN="${!AVP_VAR}"
    COGNITO_USER_POOL_ARN=""
    ;;
  aws-cognito)
    COGNITO_VAR="COGNITO_USER_POOL_ARN_${ENV_SUFFIX}"
    : "${!COGNITO_VAR:?${COGNITO_VAR} is required when AUTH_TYPE=aws-cognito}"
    COGNITO_USER_POOL_ARN="${!COGNITO_VAR}"
    AVP_POLICY_STORE_ARN=""
    ;;
  *)
    echo "ERROR: AUTH_TYPE must be 'aws-avp' or 'aws-cognito', got: '$AUTH_TYPE'" >&2
    exit 1
    ;;
esac
AVP_POLICY_STORE_ID=$(echo "$AVP_POLICY_STORE_ARN" | cut -d'/' -f2)

export AUTH_TYPE
export COGNITO_USER_POOL_ARN
export AVP_POLICY_STORE_ARN
export AVP_POLICY_STORE_ID
