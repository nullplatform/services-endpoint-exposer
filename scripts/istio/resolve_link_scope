#!/bin/bash

# Resolve Link Scope: picks the scope of the linking application that receives the
# traffic of a link that doesn't name one.
#
# The link form can't offer the scopes (the platform doesn't pass them to the link
# context), so the scope is resolved from the service's visibility instead: the
# application's scope in the link's dimensions whose visibility matches (public →
# reachability public / visibility external, private → anything else) and that has
# a Kubernetes Service to route to. A single active match is used, even next to
# inactive ones; with no active match, a single inactive one is used. It is logged and
# stored on the link (update_link_results). Several active matches, or several
# inactive ones and no active one, fail and ask for the scope on the link: guessing
# could route to the wrong one. No match fails, and so does a scope list that can't be read.
#
# Sourced by build_link_context.
# Required: CONTEXT, APPLICATION_ID, VISIBILITY (public|private)
# Sets: ROUTE_SCOPE, APP_SCOPES

LINK_DIMENSIONS=$(echo "$CONTEXT" | jq -c '.link.dimensions // {}')

echo "Resolving the $VISIBILITY scope of application $APPLICATION_ID for dimensions $LINK_DIMENSIONS..."

# stderr goes to a file so a warning on success can't corrupt the JSON.
ERRORS_FILE=$(mktemp)

# An error body without .results must not read as "no scopes".
if ! APP_SCOPES=$(np scope list --application_id "$APPLICATION_ID" --limit 200 --format json 2>"$ERRORS_FILE" \
    | jq -ce '.results | arrays' 2>>"$ERRORS_FILE"); then
  echo "ERROR: could not list the scopes of application $APPLICATION_ID: $(cat "$ERRORS_FILE")" >&2
  rm -f "$ERRORS_FILE"
  exit 1
fi

# The application may run in its own namespace, so its Services are looked up across
# the cluster (list_cluster_wide in config fails rather than look at a single one).
K8S_SERVICES=$(list_cluster_wide services) || { rm -f "$ERRORS_FILE"; exit 1; }
# Only the platform's Services make a scope routable (PLATFORM_SERVICES_JQ in config).
ROUTABLE_SCOPE_IDS=$(echo "$K8S_SERVICES" | jq -c "$PLATFORM_SERVICES_JQ"' platform_services | [.[].spec.selector.scope_id] | unique')

if ! CANDIDATES=$(echo "$APP_SCOPES" | jq -c \
  --argjson dims "$LINK_DIMENSIONS" \
  --arg visibility "$VISIBILITY" \
  --argjson routable "$ROUTABLE_SCOPE_IDS" '
  [.[]
   | select((.status // "") | IN("deleted", "deleting") | not)
   | select(. as $scope | $dims | to_entries | all(.value == ($scope.dimensions // {})[.key]))
   # Containers scopes keep visibility as a string ("public"); others as {reachability}.
   | (((.capabilities.visibility | if type == "object" then .reachability else . end)
       // .service.attributes.visibility // "public") as $r
      | if $r == "public" or $r == "external" then "public" else "private" end) as $scope_visibility
   | select($scope_visibility == $visibility)
   | select((.id | tostring) as $id | $routable | index($id))
   | {slug, id, status, created_at: (.created_at // "")}]
  | sort_by([(.status != "active"), .created_at, .id])' 2>"$ERRORS_FILE"); then
  echo "ERROR: could not read the scopes of application $APPLICATION_ID: $(cat "$ERRORS_FILE")" >&2
  rm -f "$ERRORS_FILE"
  exit 1
fi
rm -f "$ERRORS_FILE"

CANDIDATE_COUNT=$(echo "$CANDIDATES" | jq 'length')
if [[ "$CANDIDATE_COUNT" -eq 0 ]]; then
  echo "ERROR: application $APPLICATION_ID has no $VISIBILITY scope running in Kubernetes for dimensions $LINK_DIMENSIONS." >&2
  echo "Deploy one, or name the scope on the link." >&2
  exit 1
fi

# One active scope (or a single candidate) is unambiguous. With several, guessing
# could send the link to the wrong one (e.g. a new scope that replaces an old
# one), so the developer has to name it.
ACTIVE=$(echo "$CANDIDATES" | jq -c 'map(select(.status == "active"))')
if [[ "$(echo "$ACTIVE" | jq 'length')" -eq 1 ]]; then
  PICKED="$ACTIVE"
elif [[ "$(echo "$ACTIVE" | jq 'length')" -eq 0 && "$(echo "$CANDIDATES" | jq 'length')" -eq 1 ]]; then
  PICKED="$CANDIDATES"
else
  AMBIGUOUS="$CANDIDATES"
  [[ "$(echo "$ACTIVE" | jq 'length')" -gt 1 ]] && AMBIGUOUS="$ACTIVE"
  echo "ERROR: application $APPLICATION_ID has more than one $VISIBILITY scope for dimensions $LINK_DIMENSIONS:" \
    "$(echo "$AMBIGUOUS" | jq -r 'map("\(.slug) (\(.status))") | join(", ")')." >&2
  echo "Name the scope on each route of the link." >&2
  exit 1
fi

ROUTE_SCOPE=$(echo "$PICKED" | jq -r '.[0].slug')
echo "Resolved scope: $ROUTE_SCOPE (id $(echo "$PICKED" | jq -r '.[0].id'), $(echo "$PICKED" | jq -r '.[0].status'))"

OTHER_SCOPES=$(echo "$CANDIDATES" | jq -r --arg slug "$ROUTE_SCOPE" 'map(select(.slug != $slug) | "\(.slug) (\(.status))") | join(", ")')
if [[ -n "$OTHER_SCOPES" ]]; then
  echo "WARNING: inactive $VISIBILITY scopes also match: $OTHER_SCOPES. $ROUTE_SCOPE is the only active one."
fi
