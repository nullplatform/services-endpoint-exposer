#!/bin/bash

# Resolve Link Scope: picks the scope of the linking application that receives the
# traffic of a link that doesn't name one.
#
# The link form can't offer the scopes (the platform doesn't pass them to the link
# context), so the scope is resolved from the service's visibility instead: the
# application's scope in the link's dimensions whose visibility matches (public →
# reachability public / visibility external, private → anything else) and that has
# a Kubernetes Service to route to. With several matches the pick is deterministic,
# never "whatever the API listed first": active scopes first, then the oldest. It is
# logged with the other candidates and stored on the link (update_link_results), so
# the developer sees which scope serves the path and can name another one.
# No match fails.
#
# Sourced by build_link_context.
# Required: CONTEXT, APPLICATION_ID, VISIBILITY (public|private), K8S_NAMESPACE
# Sets: ROUTE_SCOPE, APP_SCOPES

LINK_DIMENSIONS=$(echo "$CONTEXT" | jq -c '.link.dimensions // {}')

echo "Resolving the $VISIBILITY scope of application $APPLICATION_ID for dimensions $LINK_DIMENSIONS..."

APP_SCOPES=$(np scope list --application_id "$APPLICATION_ID" --limit 200 --format json | jq -c '.results // []')

# The application may run in its own namespace, so its Services are looked up across
# the cluster; without cluster-wide list, only K8S_NAMESPACE (the previous behavior).
if ! K8S_SERVICES=$(kubectl get services --all-namespaces -o json 2>/dev/null); then
  echo "WARNING: could not list Services across namespaces; looking only in $K8S_NAMESPACE"
  if ! K8S_SERVICES=$(kubectl get services -n "$K8S_NAMESPACE" -o json 2>&1); then
    echo "ERROR: could not list Services in $K8S_NAMESPACE: $K8S_SERVICES" >&2
    exit 1
  fi
fi
# Only the platform's Services make a scope routable (PLATFORM_SERVICES_JQ in config).
ROUTABLE_SCOPE_IDS=$(echo "$K8S_SERVICES" | jq -c "$PLATFORM_SERVICES_JQ"' platform_services | [.[].spec.selector.scope_id] | unique')

CANDIDATES=$(echo "$APP_SCOPES" | jq -c \
  --argjson dims "$LINK_DIMENSIONS" \
  --arg visibility "$VISIBILITY" \
  --argjson routable "$ROUTABLE_SCOPE_IDS" '
  [.[]
   | select((.status // "") | IN("deleted", "deleting") | not)
   | select(. as $scope | $dims | to_entries | all(.value == ($scope.dimensions // {})[.key]))
   | ((.capabilities.visibility.reachability // .service.attributes.visibility // "public") as $r
      | if $r == "public" or $r == "external" then "public" else "private" end) as $scope_visibility
   | select($scope_visibility == $visibility)
   | select((.id | tostring) as $id | $routable | index($id))
   | {slug, id, status, created_at: (.created_at // "")}]
  | sort_by([(.status != "active"), .created_at, .id])')

if [[ "$(echo "$CANDIDATES" | jq 'length')" -eq 0 ]]; then
  echo "ERROR: application $APPLICATION_ID has no $VISIBILITY scope running in Kubernetes for dimensions $LINK_DIMENSIONS." >&2
  echo "Deploy one, or name the scope on the link." >&2
  exit 1
fi

ROUTE_SCOPE=$(echo "$CANDIDATES" | jq -r '.[0].slug')
echo "Resolved scope: $ROUTE_SCOPE (id $(echo "$CANDIDATES" | jq -r '.[0].id'), $(echo "$CANDIDATES" | jq -r '.[0].status'))"

OTHER_SCOPES=$(echo "$CANDIDATES" | jq -r '.[1:] | map("\(.slug) (\(.status))") | join(", ")')
if [[ -n "$OTHER_SCOPES" ]]; then
  echo "WARNING: other $VISIBILITY scopes also match: $OTHER_SCOPES. $ROUTE_SCOPE was picked" \
    "(active first, then the oldest); name the scope on the link to use another one."
fi
