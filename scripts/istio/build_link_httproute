#!/bin/bash

# Build Link HTTPRoute: one HTTPRoute per link, on the service's domain and gateway.
# Gateway API merges every HTTPRoute that shares a hostname, so each link owns its
# resource and unlink only deletes its own (by the link-id label).

set -euo pipefail

source "$SERVICE_PATH/scripts/istio/config"

HTTPROUTE_FILE="$OUTPUT_DIR/httproute-link-$LINK_ID.yaml"
CONTEXT_PATH="$OUTPUT_DIR/httproute-link-context-$LINK_ID.json"

jq -n \
  --arg name "$SERVICE_SLUG-link-$LINK_ID" \
  --arg service_slug "$SERVICE_SLUG" \
  --arg service_id "$SERVICE_ID" \
  --arg link_id "$LINK_ID" \
  --arg k8s_namespace "$K8S_NAMESPACE" \
  --arg domain_name "$DOMAIN_NAME" \
  --arg gateway_name "$GATEWAY_NAME" \
  --arg gateway_namespace "$GATEWAY_NAMESPACE" \
  '{
    name: $name,
    service_slug: $service_slug,
    service_id: $service_id,
    link_id: $link_id,
    k8s_namespace: $k8s_namespace,
    hostnames: [$domain_name],
    gateway_name: $gateway_name,
    gateway_namespace: $gateway_namespace
  }' > "$CONTEXT_PATH"

echo "Generating HTTPRoute for link $LINK_ID on $DOMAIN_NAME"
gomplate -c .="$CONTEXT_PATH" \
  -f "$SERVICE_PATH/templates/istio/httproute.yaml.tpl" \
  -o "$HTTPROUTE_FILE"
rm "$CONTEXT_PATH"

# Fill the rules (backend resolution, blue/green weights) with the same logic as the
# legacy model, for this link's single route.
export HTTPROUTE_FILE
source "$SERVICE_PATH/scripts/istio/process_routes"

# No route got a backend, so the template's catch-all placeholder rule (/ to a
# Service that doesn't exist) is all that's left: applying it would answer 500 on
# every undeclared path of the domain. The link gets no HTTPRoute until one of its
# scopes is deployed (the deploy sync updates it then), and apply deletes the old one.
if [[ "$(yq '(.spec.rules | length) == 1 and .spec.rules[0].backendRefs[0].name == "response-404"' "$HTTPROUTE_FILE")" == "true" ]]; then
  echo "WARNING: no route of link $LINK_ID has a backend: its HTTPRoute is removed until a scope is deployed"
  rm "$HTTPROUTE_FILE"
  touch "$OUTPUT_DIR/.httproute-link-deleted"
  return 0 2>/dev/null || exit 0
fi

echo "✅ HTTPRoute created: $HTTPROUTE_FILE"
