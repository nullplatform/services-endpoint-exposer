#!/bin/bash

# Build Rule: resolves which Kubernetes service(s) back a scope and exports
# SCOPE_RULE for build_ingress_with_rule:
#   {service: {name, port}}                          one destination
#   {blue_green_annotation: {forward: {targetGroups: [blue, green]}}, service: blue}
#                                                    weighted blue/green
#
# A scope's services are named d-<scope_id>-<deployment_id> and select their
# pods by spec.selector.deployment_id. Blue is the scope's active deployment and
# green the in-progress one; they are identified by deployment id, never by
# position (kubectl lists them by name, which says nothing about which is new).
# Only Services created by the platform count (PLATFORM_SERVICES_JQ in config).
# A scope without one gets an empty SCOPE_RULE: process_routes leaves its routes
# out of the HTTPRoute, so the gateway answers 404, instead of pointing them at a
# Service that doesn't exist (which Gateway API answers with 500).
# Sourced once per route x method, so the result is cached per scope for the
# rest of the run.

set -euo pipefail

source "$SERVICE_PATH/scripts/istio/config"

if [[ "${_BUILD_RULE_CACHED_SCOPE:-}" == "$SCOPE_ID" ]]; then
  SCOPE_RULE="${_BUILD_RULE_CACHED_RULE:-}"
  echo "Using cached backend for scope_id=$SCOPE_ID: $(echo "${SCOPE_RULE:-null}" | jq -c '.blue_green_annotation.forward.targetGroups // .service.name')"
  return 0
fi

SCOPE_JSON=$(np scope read --id "$SCOPE_ID" --format json)
ACTIVE_DEPLOYMENT=$(echo "$SCOPE_JSON" | jq -r '.active_deployment // "" | tostring')
IN_PROGRESS_DEPLOYMENT=$(echo "$SCOPE_JSON" | jq -r '.in_progress_deployment // "" | tostring')
[[ "$ACTIVE_DEPLOYMENT" == "null" ]] && ACTIVE_DEPLOYMENT=""
[[ "$IN_PROGRESS_DEPLOYMENT" == "null" ]] && IN_PROGRESS_DEPLOYMENT=""
SCOPE_STATUS=$(echo "$SCOPE_JSON" | jq -r '.status // ""')
SCOPE_SLUG_FOR_LOG=$(echo "$SCOPE_JSON" | jq -r '.slug // ""')

# The routes are still rendered (the scope may come back, and the deploy sync
# updates the exposer when it does), but a broken scope is called out.
if [[ -n "$SCOPE_STATUS" && "$SCOPE_STATUS" != "active" ]]; then
  echo "WARNING: scope ${SCOPE_SLUG_FOR_LOG:-$SCOPE_ID} (id $SCOPE_ID) is $SCOPE_STATUS: its routes may have no backend"
fi
if [[ -z "$ACTIVE_DEPLOYMENT" && -z "$IN_PROGRESS_DEPLOYMENT" ]]; then
  echo "WARNING: scope ${SCOPE_SLUG_FOR_LOG:-$SCOPE_ID} (id $SCOPE_ID) has no active deployment: its routes get no backend until it is deployed"
fi

DEPLOYMENT_STATUS=""
SWITCHED_TRAFFIC=0
if [[ -n "$IN_PROGRESS_DEPLOYMENT" ]]; then
  DEPLOYMENT_JSON=$(np deployment read --id "$IN_PROGRESS_DEPLOYMENT" --format json)
  DEPLOYMENT_STATUS=$(echo "$DEPLOYMENT_JSON" | jq -r '.status // ""')
  SWITCHED_TRAFFIC=$(echo "$DEPLOYMENT_JSON" | jq -r '.strategy_data.desired_switched_traffic // 0')
fi
echo "Scope $SCOPE_ID: active_deployment=${ACTIVE_DEPLOYMENT:-none} in_progress=${IN_PROGRESS_DEPLOYMENT:-none} status=${DEPLOYMENT_STATUS:-none} switched_traffic=$SWITCHED_TRAFFIC"

# stderr stays out of the JSON (warnings used to corrupt it)
# Additional ports get their own Services with the same selector: the main one
# is named d-<scope_id>-<deployment_id>, so it sorts first.
SERVICES_JSON=$(kubectl get services -n "$K8S_NAMESPACE" -o json \
  | jq --arg scope_id "$SCOPE_ID" "$PLATFORM_SERVICES_JQ"' platform_services
      | [.[] | select(.spec.selector.scope_id == $scope_id)
        | {name: .metadata.name, port: .spec.ports[0].port, deployment_id: .spec.selector.deployment_id}]
      | sort_by(.name != "d-\($scope_id)-\(.deployment_id)")')

service_for() {
  echo "$SERVICES_JSON" | jq -c --arg d "$1" 'first(.[] | select(.deployment_id == $d)) // empty'
}

single_rule() {
  jq -n --arg name "$(echo "$1" | jq -r .name)" --argjson port "$(echo "$1" | jq .port)" \
    '{service: {name: $name, port: {number: $port}}}'
}

BLUE=""
GREEN=""
[[ -n "$ACTIVE_DEPLOYMENT" ]] && BLUE=$(service_for "$ACTIVE_DEPLOYMENT")
[[ -n "$IN_PROGRESS_DEPLOYMENT" && "$IN_PROGRESS_DEPLOYMENT" != "$ACTIVE_DEPLOYMENT" ]] && GREEN=$(service_for "$IN_PROGRESS_DEPLOYMENT")

# Without a usable active deployment, fall back to the newest service
# (highest deployment id), which is what a scope with a single service has.
if [[ -z "$BLUE" ]]; then
  GREEN_NAME=""
  [[ -n "$GREEN" ]] && GREEN_NAME=$(echo "$GREEN" | jq -r .name)
  BLUE=$(echo "$SERVICES_JSON" | jq -c --arg green "$GREEN_NAME" \
    '[.[] | select(.name != $green)] | sort_by(.deployment_id | tonumber? // 0) | last // empty')
fi

case "$DEPLOYMENT_STATUS" in
  finalizing|finalized)
    TARGET="green" ;;
  rolling_back|rolled_back|cancelling|cancelled|failed|deleting)
    TARGET="blue" ;;
  "")
    TARGET="blue" ;;
  *)
    # creating, waiting_for_instances, running, switching_traffic...
    TARGET="weighted" ;;
esac

if [[ -z "$BLUE" && -z "$GREEN" ]]; then
  echo "WARNING: no platform Service for scope_id=$SCOPE_ID in namespace $K8S_NAMESPACE: its routes are left out of the HTTPRoute (404)"
  SCOPE_RULE=""
elif [[ "$TARGET" == "green" && -n "$GREEN" ]] || [[ -z "$BLUE" ]]; then
  echo "Routing scope_id=$SCOPE_ID to $(echo "$GREEN" | jq -r .name) (in-progress deployment, status=${DEPLOYMENT_STATUS:-none})"
  SCOPE_RULE=$(single_rule "$GREEN")
elif [[ "$TARGET" == "weighted" && -n "$GREEN" ]]; then
  GREEN_WEIGHT=$SWITCHED_TRAFFIC
  BLUE_WEIGHT=$((100 - SWITCHED_TRAFFIC))
  echo "Blue/green for scope_id=$SCOPE_ID: $(echo "$BLUE" | jq -r .name)=$BLUE_WEIGHT $(echo "$GREEN" | jq -r .name)=$GREEN_WEIGHT"
  SCOPE_RULE=$(jq -n \
    --arg blue_service "$(echo "$BLUE" | jq -r .name)" \
    --argjson blue_weight "$BLUE_WEIGHT" \
    --arg green_service "$(echo "$GREEN" | jq -r .name)" \
    --argjson green_weight "$GREEN_WEIGHT" \
    --argjson port "$(echo "$BLUE" | jq .port)" \
    '{
      blue_green_annotation: {forward: {targetGroups: [
        {serviceName: $blue_service, weight: $blue_weight},
        {serviceName: $green_service, weight: $green_weight}
      ]}},
      service: {name: $blue_service, port: {number: $port}}
    }')
else
  echo "Routing scope_id=$SCOPE_ID to $(echo "$BLUE" | jq -r .name) (active deployment)"
  SCOPE_RULE=$(single_rule "$BLUE")
fi

_BUILD_RULE_CACHED_SCOPE="$SCOPE_ID"
_BUILD_RULE_CACHED_RULE="$SCOPE_RULE"
export SCOPE_RULE
