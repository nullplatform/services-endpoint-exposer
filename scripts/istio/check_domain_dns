#!/bin/bash

# Check Domain DNS: the domain must exist in DNS, wherever it is hosted (Route 53,
# GoDaddy, Cloudflare, an internal DNS server...), and should point at the gateway.
#
# Which DNS answers depends on the visibility:
#   public  - public resolvers (PUBLIC_DNS_RESOLVERS, default 1.1.1.1 8.8.8.8), so the
#             check sees what internet clients see, not a split-horizon private view
#             of the same zone. Falls back to the system resolver if none replies.
#   private - the agent's own resolver: the agent runs inside the client's network,
#             so it sees the client's internal DNS.
#
# A domain that doesn't resolve fails (DOMAIN_DNS_CHECK=enforce, default), telling
# apart a domain that isn't registered from a zone that lacks the record. A domain
# that resolves somewhere other than the gateway only warns: a CDN or proxy may sit
# in front, but usually it means the requests will never reach the gateway.
#
# DOMAIN_DNS_CHECK: enforce (default) | warn (report, never fail) | off (skip)
#
# The agent images don't always ship dig, so the check uses whatever is there
# (DNS_TOOL=auto, default): dig, else getent (the agent's resolver only, which
# can't name the zone of a missing record), else it warns and skips: a check
# that can't run doesn't block the service.

set -euo pipefail

source "$SERVICE_PATH/scripts/istio/config"

: "${DOMAIN_NAME:?DOMAIN_NAME is required}"
: "${GATEWAY_NAME:?GATEWAY_NAME is required}"

DOMAIN_DNS_CHECK="${DOMAIN_DNS_CHECK:-enforce}"
VISIBILITY="${VISIBILITY:-public}"

if [[ "$DOMAIN_DNS_CHECK" == "off" ]]; then
  echo "DOMAIN_DNS_CHECK=off: skipping the DNS check of '$DOMAIN_NAME'"
  return 0 2>/dev/null || exit 0
fi

DNS_TOOL="${DNS_TOOL:-auto}"
if [[ "$DNS_TOOL" == "auto" ]]; then
  if command -v dig > /dev/null; then
    DNS_TOOL=dig
  elif command -v getent > /dev/null; then
    DNS_TOOL=getent
  else
    DNS_TOOL=none
  fi
fi

if [[ "$DNS_TOOL" == "none" ]]; then
  echo "WARNING: neither dig nor getent is available: skipping the DNS check of '$DOMAIN_NAME'"
  return 0 2>/dev/null || exit 0
fi

dns_problem() {
  if [[ "$DOMAIN_DNS_CHECK" == "warn" ]]; then
    echo "WARNING: $*"
  else
    echo "ERROR: $*" >&2
    exit 1
  fi
}

# Public domains are checked against public resolvers; the first that replies wins.
RESOLVER_ARGS=()
RESOLVER_LABEL="the agent's resolver"
if [[ "$VISIBILITY" == "public" && "$DNS_TOOL" == "getent" ]]; then
  echo "WARNING: dig is not available: checking '$DOMAIN_NAME' with the agent's resolver (getent), not a public one"
elif [[ "$VISIBILITY" == "public" ]]; then
  for RESOLVER in ${PUBLIC_DNS_RESOLVERS:-1.1.1.1 8.8.8.8}; do
    if dig +time=3 +tries=1 +short "@$RESOLVER" . NS > /dev/null 2>&1; then
      RESOLVER_ARGS=("@$RESOLVER")
      RESOLVER_LABEL="public resolver $RESOLVER"
      break
    fi
  done
  if [[ ${#RESOLVER_ARGS[@]} -eq 0 ]]; then
    echo "WARNING: no public resolver replied (${PUBLIC_DNS_RESOLVERS:-1.1.1.1 8.8.8.8}); using the agent's resolver"
  fi
fi

# resolve <name>: sets RESOLVED to the addresses (dig also lists the CNAME chain),
# one per line. A query that gets no reply (dig exits non-zero, e.g. 9: no server reachable) is not
# an empty answer: it returns 1 with RESOLVE_ERROR set, so it is reported as such
# instead of as a missing domain (or, with pipefail, aborting without a message).
# getent can't tell a missing name from a resolver that doesn't answer (both exit 2).
resolve() {
  local name="$1" type out rc
  RESOLVED=""
  RESOLVE_ERROR=""
  if [[ "$DNS_TOOL" == "getent" ]]; then
    out=$(getent ahosts "$name" 2>/dev/null) || true
    RESOLVED=$(echo "$out" | awk 'NF {print $1}' | sort -u)
    return 0
  fi
  for type in A AAAA; do
    rc=0
    out=$(dig +time=3 +tries=2 +short ${RESOLVER_ARGS[@]+"${RESOLVER_ARGS[@]}"} "$name" "$type" 2>&1) || rc=$?
    if [[ "$rc" -ne 0 ]]; then
      RESOLVE_ERROR="could not query the $type records of '$name' with $RESOLVER_LABEL (dig exit $rc: $(echo "$out" | sed '/^$/d' | tail -1))"
      return 1
    fi
    RESOLVED+=$'\n'"$(echo "$out" | { grep -v '^;' || true; } | sed 's/\.$//')"
  done
  RESOLVED=$(echo "$RESOLVED" | sed '/^$/d' | sort -u)
}

echo "Checking DNS of '$DOMAIN_NAME' ($VISIBILITY) with $RESOLVER_LABEL..."

if ! resolve "$DOMAIN_NAME"; then
  dns_problem "$RESOLVE_ERROR. Check that the agent can reach a DNS server."
  return 0 2>/dev/null || exit 0
fi
ANSWER="$RESOLVED"

if [[ -z "$ANSWER" && "$DNS_TOOL" == "getent" ]]; then
  dns_problem "'$DOMAIN_NAME' doesn't resolve with the agent's resolver: the record doesn't exist, or the resolver didn't answer. Register the domain and create the record pointing at the gateway first."
  return 0 2>/dev/null || exit 0
fi

if [[ -z "$ANSWER" ]]; then
  # The authority section names the closest existing zone, even on NXDOMAIN. A
  # lookup that gets no reply can't tell which zone is missing the record.
  SOA_RC=0
  SOA=$(dig +time=3 +tries=2 +noall +authority ${RESOLVER_ARGS[@]+"${RESOLVER_ARGS[@]}"} "$DOMAIN_NAME" SOA 2>&1) || SOA_RC=$?
  if [[ "$SOA_RC" -ne 0 ]]; then
    dns_problem "'$DOMAIN_NAME' has no A/AAAA/CNAME record, and its zone could not be looked up with $RESOLVER_LABEL (dig exit $SOA_RC). Create the record pointing at the gateway first."
    return 0 2>/dev/null || exit 0
  fi
  ZONE=$(echo "$SOA" | awk '$4 == "SOA" && !found {print $1; found = 1}' | sed 's/\.$//')
  if [[ -z "$ZONE" || "$ZONE" != *.* ]]; then
    dns_problem "'$DOMAIN_NAME' doesn't exist in DNS: no zone serves it${ZONE:+ (only the TLD '$ZONE')}. Register the domain or fix the name."
  else
    dns_problem "'$DOMAIN_NAME' has no A/AAAA/CNAME record in zone '$ZONE'. Create the record pointing at the gateway first."
  fi
  return 0 2>/dev/null || exit 0
fi

echo "'$DOMAIN_NAME' resolves to: $(echo "$ANSWER" | tr '\n' ' ')"

# Where the gateway can be reached: its status addresses and what they resolve to.
GATEWAY_ADDRESSES=$(kubectl get gateway "$GATEWAY_NAME" -n "$GATEWAY_NAMESPACE" \
  -o jsonpath='{range .status.addresses[*]}{.value}{"\n"}{end}' 2>/dev/null || true)

if [[ -z "$GATEWAY_ADDRESSES" ]]; then
  echo "WARNING: gateway $GATEWAY_NAMESPACE/$GATEWAY_NAME has no address yet; can't check that '$DOMAIN_NAME' points at it"
  return 0 2>/dev/null || exit 0
fi

# The gateway's hostname (e.g. a load balancer's) is resolved with the agent's
# resolver, not the public one. (A `VAR=() cmd` prefix would set it to the string
# "()", not empty it.)
RESOLVER_ARGS=()
RESOLVER_LABEL="the agent's resolver"
GATEWAY_TARGETS="$GATEWAY_ADDRESSES"
while IFS= read -r ADDRESS; do
  [[ -z "$ADDRESS" || "$ADDRESS" =~ ^[0-9.:]+$ ]] && continue
  # If that fails, the domain only can't be matched to it (a warning below).
  if resolve "$ADDRESS"; then
    GATEWAY_TARGETS+=$'\n'"$RESOLVED"
  else
    echo "WARNING: $RESOLVE_ERROR"
  fi
done <<< "$GATEWAY_ADDRESSES"

if grep -qxFf <(echo "$GATEWAY_TARGETS" | sed '/^$/d') <<< "$ANSWER"; then
  echo "✅ '$DOMAIN_NAME' points at gateway $GATEWAY_NAMESPACE/$GATEWAY_NAME"
else
  echo "WARNING: '$DOMAIN_NAME' doesn't point at gateway $GATEWAY_NAMESPACE/$GATEWAY_NAME" \
    "($(echo "$GATEWAY_ADDRESSES" | tr '\n' ' ')). Unless a CDN or proxy forwards to it," \
    "requests to the domain won't reach its routes: point the record at the gateway."
fi
