#!/bin/bash

# Delete Service Resources: removes any HTTPRoute / AuthorizationPolicy still labeled
# with this service. Links clean up their own resources on unlink; this is the safety
# net for links that ended in failed/cancelled without running unlink.

set -euo pipefail

source "$SERVICE_PATH/scripts/istio/config"

LABELS="nullplatform.com/managed-by=http-route-access-control,nullplatform.com/service-id=$SERVICE_ID"

echo "Deleting leftover HTTPRoutes for service $SERVICE_ID in $K8S_NAMESPACE..."
kubectl delete httproute -n "$K8S_NAMESPACE" -l "$LABELS" --ignore-not-found

# sync_gateway_baseline only stops excluding hosts that a run removed.
kubectl get authorizationpolicy -n "$GATEWAY_NAMESPACE" -l "$LABELS" -o json \
  | jq -r '.items[].spec.rules[]?.to[]?.operation.hosts[]?' >> "$OUTPUT_DIR/.authz-removed-hosts" || true
echo "Deleting leftover AuthorizationPolicies for service $SERVICE_ID in $GATEWAY_NAMESPACE..."
kubectl delete authorizationpolicy -n "$GATEWAY_NAMESPACE" -l "$LABELS" --ignore-not-found
