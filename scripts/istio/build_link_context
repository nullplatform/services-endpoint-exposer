#!/bin/bash

# Build Link Context (domain model): a link exposes the paths of the linking
# application on the domain of the service it is linked to.
#
#   service attributes: domain_name, visibility
#   link attributes:    routes: [{path, methods (optional: ALL by default),
#                                 groups (optional with AUTH_TYPE=none),
#                                 scope (optional: resolved from the service's visibility)}]
#
# Exports ROUTES_JSON in the same shape the legacy model uses
# ({path, methods, groups, scope, visibility}), so process_routes, build_rule and
# build_allow_policies are reused unchanged.
#
# LINK_OPERATION (workflow configuration):
#   apply  - link create/update: validates the route (default)
#   delete - unlink: only identifies the link, whatever state its attributes are in

set -euo pipefail

source "$SERVICE_PATH/scripts/istio/config"

# The notification payload lives in $NP_ACTION_CONTEXT, wrapped as {"notification": ...}
# and sometimes single-quoted; fall back to $CONTEXT (tests).
CONTEXT=$(echo "${NP_ACTION_CONTEXT:-$CONTEXT}" | sed "s/^'//;s/'$//" | jq -c '.notification // .')

LINK_OPERATION="${LINK_OPERATION:-apply}"

SERVICE_ID=$(echo "$CONTEXT" | jq -r '.service.id // ""')
SERVICE_SLUG=$(echo "$CONTEXT" | jq -r '.service.slug // ""')
LINK_ID=$(echo "$CONTEXT" | jq -r '.link.id // ""')
ACTION_ID=$(echo "$CONTEXT" | jq -r '.id // ""')
ACTION_NAME=$(echo "$CONTEXT" | jq -r '.slug // ""')

if [[ -z "$LINK_ID" ]]; then
  echo "ERROR: link.id not found in the notification" >&2
  exit 1
fi

K8S_NAMESPACE="${NAMESPACE_OVERRIDE:-${K8S_NAMESPACE:-nullplatform}}"

# Only set OUTPUT_DIR if not already set (allows tests to override)
if [[ -z "${OUTPUT_DIR:-}" ]]; then
  export OUTPUT_DIR="$SERVICE_PATH/output/$SERVICE_SLUG-$SERVICE_ID/link-$LINK_ID/$ACTION_NAME-$ACTION_ID"
fi
mkdir -p "$OUTPUT_DIR"

export SERVICE_ID
export SERVICE_SLUG
export LINK_ID
export ACTION_ID
export ACTION_NAME
export K8S_NAMESPACE

if [[ "$LINK_OPERATION" == "delete" ]]; then
  echo "Unlink $LINK_ID from service $SERVICE_SLUG ($SERVICE_ID)"
  return 0 2>/dev/null || exit 0
fi

# --- Service side: the domain every path of this service hangs from --------------

SERVICE_JSON=$(echo "$CONTEXT" | jq -c '.service // {}')
if [[ -z "$(echo "$SERVICE_JSON" | jq -r '.attributes.domain_name // ""')" ]]; then
  # Link notifications don't always embed the service attributes.
  SERVICE_JSON=$(np service read --id "$SERVICE_ID" --format json)
fi

DOMAIN_NAME=$(echo "$SERVICE_JSON" | jq -r '.attributes.domain_name // ""')
VISIBILITY=$(echo "$SERVICE_JSON" | jq -r '.attributes.visibility // "public"')

if [[ -z "$DOMAIN_NAME" ]]; then
  echo "ERROR: service $SERVICE_ID has no domain_name. Links only expose paths on domain services;" >&2
  echo "services that still declare their routes inline must be migrated first." >&2
  exit 1
fi

if [[ "$VISIBILITY" == "private" ]]; then
  GATEWAY_NAME="$PRIVATE_GATEWAY_NAME"
else
  GATEWAY_NAME="$PUBLIC_GATEWAY_NAME"
fi

# --- Link side: the routes this link exposes --------------------------------------

# Parameters of the running action win over the stored link attributes (update).
LINK_ATTRIBUTES_JSON=$(echo "$CONTEXT" | jq -c '(.link.attributes // {}) * (.parameters // {})')

# The platform allows a single link per application and dimensions, so a link
# carries every path the application exposes on the domain. Links created before
# the list held one route in top-level path/methods/groups/scope: read them as a
# one-route list.
ROUTES_JSON=$(echo "$LINK_ATTRIBUTES_JSON" | jq -c \
  --arg visibility "$VISIBILITY" \
  --arg link_scope "$(echo "$CONTEXT" | jq -r '.link.scope.slug // ""')" '
  def group_list:
    if type == "array" then .
    elif type == "string" then split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""))
    else [] end;
  (if ((.routes // []) | length) > 0 then .routes
   elif (.path // "") != "" then [{path, methods, method, groups, scope}]
   else [] end)
  | map({
      path: (.path // ""),
      methods: ((.methods // (if .method then [.method] else [] end))
        | if length == 0 then ["ALL"] else . end),
      groups: (.groups | group_list),
      scope: (if (.scope // "") != "" then .scope else $link_scope end),
      visibility: (if $visibility == "private" then "internal" else "public" end)
    })')

if [[ "$(echo "$ROUTES_JSON" | jq 'length')" -eq 0 ]]; then
  echo "ERROR: the link has no routes: add at least one path" >&2
  exit 1
fi

INVALID_PATHS=$(echo "$ROUTES_JSON" | jq -r '
  map(.path | select(test("^/[a-zA-Z0-9_./:*{}-]*$") | not) | if . == "" then "(empty)" else . end) | join(", ")')
if [[ -n "$INVALID_PATHS" ]]; then
  echo "ERROR: paths must start with / (e.g. /api/users, /items/:id, /files/*); invalid: $INVALID_PATHS" >&2
  exit 1
fi

INVALID_METHODS=$(echo "$ROUTES_JSON" | jq -r '
  [.[].methods[]] - ["ALL", "GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] | unique | join(", ")')
# No verbs means every verb (ALL) was normalized above, so only unknown verbs fail.
if [[ -n "$INVALID_METHODS" ]]; then
  echo "ERROR: methods must be a subset of ALL, GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS (invalid: '${INVALID_METHODS}')" >&2
  exit 1
fi

# A path is one route: two items with the same path would render competing rules.
DUPLICATE_PATHS=$(echo "$ROUTES_JSON" | jq -r 'group_by(.path) | map(select(length > 1) | .[0].path) | join(", ")')
if [[ -n "$DUPLICATE_PATHS" ]]; then
  echo "ERROR: paths declared more than once in the link: $DUPLICATE_PATHS. Merge their verbs into a single route." >&2
  exit 1
fi

# The scope belongs to the linking application, not to the one owning the service.
APPLICATION_ID=$(echo "$CONTEXT" | jq -r '
  ((.link.entity_nrn // "") | capture("application=(?<id>[0-9]+)").id) //
  .tags.application_id //
  ((.entity_nrn // "") | capture("application=(?<id>[0-9]+)").id) //
  ""')

if [[ -z "$APPLICATION_ID" ]]; then
  echo "ERROR: could not resolve the application of link $LINK_ID" >&2
  exit 1
fi

# Routes without a scope use the application's scope matching the service's
# visibility (see resolve_link_scope), resolved once for the whole link.
if [[ "$(echo "$ROUTES_JSON" | jq 'any(.[]; .scope == "")')" == "true" ]]; then
  source "$SERVICE_PATH/scripts/istio/resolve_link_scope"
  ROUTES_JSON=$(echo "$ROUTES_JSON" | jq -c --arg scope "$ROUTE_SCOPE" 'map(if .scope == "" then .scope = $scope else . end)')
fi

# resolve_auth also rejects a route without groups unless AUTH_TYPE=none: with auth,
# an ALLOW policy without groups would let any request through on that path.
ENV_DIMENSION=$(echo "$CONTEXT" | jq -r --argjson service "$SERVICE_JSON" '
  .service.dimensions.environment // .link.dimensions.environment // $service.dimensions.environment // ""')
source "$SERVICE_PATH/scripts/istio/resolve_auth"

# No JWT is validated with AUTH_TYPE=none, so a cognito:groups condition could never
# match: drop the groups so the policies allow the paths without auth. Any other mode
# fails closed here too, whatever resolve_auth exempted.
if [[ "$AUTH_TYPE" == "none" ]]; then
  ROUTES_JSON=$(echo "$ROUTES_JSON" | jq -c 'map(.groups = [])')
else
  ROUTES_WITHOUT_GROUPS=$(echo "$ROUTES_JSON" | jq -r 'map(select((.groups // []) | length == 0) | .path) | join(", ")')
  if [[ -n "$ROUTES_WITHOUT_GROUPS" ]]; then
    echo "ERROR: at least one authorized group is required unless AUTH_TYPE=none; routes without groups: $ROUTES_WITHOUT_GROUPS" >&2
    exit 1
  fi
fi

if [[ "$AUTH_TYPE" == "aws-avp" ]]; then
  echo "ERROR: AUTH_TYPE=aws-avp is not supported by the domain + links model yet; use aws-cognito" >&2
  exit 1
fi

echo "Link $LINK_ID (app $APPLICATION_ID, gateway $GATEWAY_NAME), $(echo "$ROUTES_JSON" | jq 'length') route(s):"
echo "$ROUTES_JSON" | jq -r --arg domain "$DOMAIN_NAME" '.[] | "  \(.methods | join(",")) \($domain)\(.path) → scope \(.scope)"'

export APPLICATION_ID
export DOMAIN_NAME
export VISIBILITY
export GATEWAY_NAME
export ROUTES_JSON
export LINK_ATTRIBUTES_JSON
