#!/bin/bash

# Delete Link Resources: unlink removes exactly the HTTPRoute and AuthorizationPolicies
# of this link; other links on the same domain are untouched. The HTTPRoute goes
# first: the other way round it would serve for a moment without its ALLOW policies.

set -euo pipefail

source "$SERVICE_PATH/scripts/istio/config"

LABELS="nullplatform.com/managed-by=http-route-access-control,nullplatform.com/link-id=$LINK_ID"

# sync_gateway_baseline only stops excluding hosts that a run removed. They are read
# before anything is deleted: losing them would leave a stale exclusion behind.
REMOVED_HOSTS=$(kubectl get authorizationpolicy -n "$GATEWAY_NAMESPACE" -l "$LABELS" -o json \
  | jq -r '.items[].spec.rules[]?.to[]?.operation.hosts[]?')

# The HTTPRoute lives in its application's namespace, which unlink doesn't resolve:
# the link-id label is unique, so it is deleted wherever it is.
echo "Deleting HTTPRoute of link $LINK_ID in every namespace..."
delete_cluster_wide httproute "$LABELS"

[[ -n "$REMOVED_HOSTS" ]] && echo "$REMOVED_HOSTS" >> "$OUTPUT_DIR/.authz-removed-hosts"
echo "Deleting AuthorizationPolicies of link $LINK_ID in $GATEWAY_NAMESPACE..."
kubectl delete authorizationpolicy -n "$GATEWAY_NAMESPACE" -l "$LABELS" --ignore-not-found

echo "✅ Link $LINK_ID resources deleted"
