#!/bin/bash

# Configuration: Defines default gateway names and namespaces for public/private traffic routing.
# These values can be overridden by environment variables to support different cluster configurations.

# Gateway configuration
# These values can be overridden by environment variables
export PUBLIC_GATEWAY_NAME="${PUBLIC_GATEWAY_NAME:-gateway-public}"
export PRIVATE_GATEWAY_NAME="${PRIVATE_GATEWAY_NAME:-gateway-private}"
export GATEWAY_NAMESPACE="${GATEWAY_NAMESPACE:-gateways}"

# OPA configuration
export OPA_PROVIDER_NAME="${OPA_PROVIDER_NAME:-}"

# Cognito configuration
# When set, Istio extracts the JWT from this cookie name instead of relying on
# the default Authorization header / access_token query param.
export COGNITO_TOKEN_COOKIE_NAME="${COGNITO_TOKEN_COOKIE_NAME:-}"

# Kubernetes Services the scope agent creates for a deployment: the selector
# carries nullplatform: "true", scope_id and deployment_id. Anything else that
# happens to select a scope_id (a test echo, a hand-made Service) is never a
# backend. Usage: jq "$PLATFORM_SERVICES_JQ"' platform_services | ...'
export PLATFORM_SERVICES_JQ='def platform_services: [.items[]? | select(.spec.selector.nullplatform == "true" and (.spec.selector.scope_id // "") != "" and (.spec.selector.deployment_id // "") != "")];'

# Applications run in their own namespaces, so the exposer reads and deletes
# Services and HTTPRoutes across the cluster (README: "Applications in their own
# namespaces"). Missing cluster-wide access is never worked around with a single
# namespace: a partial view could miss a backend and remove a route that works, or
# miss a conflict. Every cluster-wide call fails with kubectl's error instead.

# list_cluster_wide <resource> [kubectl get args...]: prints the JSON list of
# <resource> in every namespace. kubectl's stderr stays out of the JSON and goes
# into the error message.
list_cluster_wide() {
  local resource="$1" err out
  shift
  err=$(mktemp)
  if ! out=$(kubectl get "$resource" --all-namespaces -o json "$@" 2>"$err"); then
    echo "ERROR: could not list $resource across namespaces: $(cat "$err")" >&2
    echo "The agent needs cluster-wide list on services and httproutes (README: RBAC)." >&2
    rm -f "$err"
    return 1
  fi
  rm -f "$err"
  echo "$out"
}

# delete_cluster_wide <resource> <label selector>: deletes every <resource> that
# matches the selector, in every namespace.
delete_cluster_wide() {
  local resource="$1" selector="$2"
  if ! kubectl delete "$resource" --all-namespaces -l "$selector" --ignore-not-found; then
    echo "ERROR: could not delete $resource ($selector) across namespaces." >&2
    echo "The agent needs cluster-wide delete on httproutes (README: RBAC)." >&2
    return 1
  fi
}

# NAMESPACE_OVERRIDE set on the channel as a template (e.g.
# "{context.tags.namespace}") reaches the agent literally when the channel
# doesn't interpolate it. That isn't a namespace: ignore it, so the namespace is
# resolved from the scope's Services instead of failing every kubectl call.
if [[ "${NAMESPACE_OVERRIDE:-}" == *"{"* || "${NAMESPACE_OVERRIDE:-}" == *"}"* ]]; then
  echo "WARNING: ignoring NAMESPACE_OVERRIDE='$NAMESPACE_OVERRIDE': it was not interpolated" >&2
  unset NAMESPACE_OVERRIDE
fi
