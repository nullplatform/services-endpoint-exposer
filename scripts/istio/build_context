#!/bin/bash

set -euo pipefail

# Under `np service workflow exec --build-context` (how entrypoint/service runs
# this workflow), the CLI sets $CONTEXT to the NRN resolution hierarchy
# ({account, application, namespace}) for each step script. That object has none
# of the notification fields read below (.service, .parameters, .dimensions), so
# every read resolved to null and create aborted with
# "service.dimensions.environment is required" / "jq: null has no keys".
# The notification payload is in $NP_ACTION_CONTEXT (exported by entrypoint/entrypoint,
# wrapped as {"notification": {...}}, sometimes single-quoted). Re-point CONTEXT at
# the notification body so the existing reads resolve. Falls back to $CONTEXT when
# NP_ACTION_CONTEXT is unset (e.g. tests), and to the whole object when it is not
# wrapped under .notification.
CONTEXT=$(echo "${NP_ACTION_CONTEXT:-$CONTEXT}" | sed "s/^'//;s/'$//" | jq -c '.notification // .')

SERVICE_ID=$(echo "$CONTEXT" | jq -r .service.id)
SERVICE_SLUG=$(echo "$CONTEXT" | jq -r .service.slug)

ACTION_ID=$(echo "$CONTEXT" | jq -r .id)
ACTION_NAME=$(echo "$CONTEXT" | jq -r .slug)

K8S_NAMESPACE="${NAMESPACE_OVERRIDE:-nullplatform}"
APPLICATION_ID=$(echo "$CONTEXT" | jq -r '.tags.application_id // ""')

# Routes come from parameters (form submission) or stored service attributes
ROUTES_JSON=$(echo "$CONTEXT" | jq -c '
  .parameters.routes //
  .notification.parameters.routes //
  .service.attributes.routes //
  []')

# Resolve scope → visibility for each route (external → "public", internal → "internal")
if [[ "$(echo "$ROUTES_JSON" | jq 'length')" -gt 0 && -n "$APPLICATION_ID" ]]; then
  SCOPES_LIST=$(np scope list --application_id "$APPLICATION_ID" --limit 200 --format json | jq '.results // []')
  ROUTES_JSON=$(echo "$ROUTES_JSON" | jq -c --argjson scopes "$SCOPES_LIST" '
    map(. as $route |
      if .visibility == null or .visibility == "" then
        (($scopes[] | select(.slug == $route.scope) | .service.attributes.visibility // "external") // "external") as $vis |
        $route + {visibility: (if $vis == "internal" then "internal" else "public" end)}
      else . end
    )')
fi

# Split routes by visibility
PUBLIC_ROUTES_JSON=$(echo "$ROUTES_JSON" | jq -c '[.[] | select(.visibility == "public" or .visibility == null or .visibility == "")]')
PRIVATE_ROUTES_JSON=$(echo "$ROUTES_JSON" | jq -c '[.[] | select(.visibility == "internal")]')

# Only set OUTPUT_DIR if not already set (allows tests to override)
if [[ -z "${OUTPUT_DIR:-}" ]]; then
  export OUTPUT_DIR="$SERVICE_PATH/output/$SERVICE_SLUG-$SERVICE_ID/$ACTION_NAME-$ACTION_ID"
fi

mkdir -p "$OUTPUT_DIR"

ENV_DIMENSION=$(echo "$CONTEXT" | jq -r '.service.dimensions.environment // ""')
source "$SERVICE_PATH/scripts/istio/resolve_auth"

export SERVICE_ID
export SERVICE_SLUG
export ACTION_ID
export ACTION_NAME
export APPLICATION_ID
export ROUTES_JSON
export PUBLIC_ROUTES_JSON
export PRIVATE_ROUTES_JSON
