#!/bin/bash

# Path utilities shared by the HTTPRoute builders (build_ingress_with_rule), the
# link path-conflict check (check_link_conflict) and the AuthorizationPolicy builder
# (build_allow_policies), so they all interpret a developer path the same way.

# Ensure a path starts with "/". The Kubernetes Gateway API rejects
# non-absolute values for the `Exact` and `PathPrefix` match types with:
#   spec.rules[N].matches[M].path: Invalid value: ...: value must be an
#   absolute path and start with '/' when type one of ['Exact', 'PathPrefix']
# Developers often enter "health" in the UI expecting it to become "/health",
# so normalize here instead of surfacing a validator error per route.
ensure_absolute_path() {
  local path="$1"
  if [[ "$path" != /* ]]; then
    echo "/$path"
  else
    echo "$path"
  fi
}

# A parameter is a segment that starts with ":" and names it ("/users/:id"). A ":"
# anywhere else ("/v1/things:batchGet", a bare "/:") is a literal character.
# Usage: has_param <path>
has_param() {
  local re='(^|/):[^/]'
  [[ "$1" =~ $re ]]
}

# Detect path type and convert path value accordingly
# Returns: "type:value" format
detect_path_type() {
  local path="$1"

  validate_param_path "$path" || return 1

  # Parameters with a trailing wildcard: one segment per param, then anything below.
  if has_param "$path" && [[ "$path" == */\* ]]; then
    local regex_prefix
    regex_prefix=$(echo "${path%/\*}" | sed -E 's#(^|/):[^/]+#\1[^/]+#g')
    echo "RegularExpression:${regex_prefix}(/.*)?"
    return
  fi

  # Check for wildcard (*) - use PathPrefix
  if [[ "$path" == *"*"* ]]; then
    # Remove trailing /* or *
    local prefix_path="${path%/*}"
    if [[ -z "$prefix_path" ]]; then
      prefix_path="/"
    fi
    prefix_path=$(ensure_absolute_path "$prefix_path")
    echo "PathPrefix:$prefix_path"
    return
  fi

  # Check for path parameters (:param) - use RegularExpression
  if has_param "$path"; then
    # Replace :param with [^/]+
    local regex_path
    regex_path=$(echo "$path" | sed -E 's#(^|/):[^/]+#\1[^/]+#g')
    # RegularExpression values are not required to be absolute by Gateway API,
    # so we leave them untouched.
    echo "RegularExpression:$regex_path"
    return
  fi

  # Default: Exact match
  path=$(ensure_absolute_path "$path")
  echo "Exact:$path"
}

# A path with parameters may only carry "*" as its last segment ("/users/:id/*"):
# neither the HTTPRoute regex nor Istio's path templates can express it elsewhere.
# Usage: validate_param_path <path>
validate_param_path() {
  local path="$1" body="${1%/\*}"
  if has_param "$path" && [[ "$body" == *"*"* ]]; then
    echo "ERROR: path '$path' mixes :parameters with a '*' that is not its last segment" >&2
    return 1
  fi
}

# Convert a developer path into an AuthorizationPolicy `paths` value, matching the
# same requests as the HTTPRoute (see detect_path_type). Istio doesn't understand
# ":param", so params become the "{*}" template (one segment) and a trailing "/*"
# becomes "/{**}" (Istio rejects "*" mixed with templates in one path). Paths
# without params pass through: Istio only treats a leading or trailing "*" as a wildcard.
# Usage: authz_path <path>
# Returns: the path for AuthorizationPolicy.spec.rules[].to[].operation.paths
authz_path() {
  local path
  validate_param_path "$1" || return 1
  path=$(ensure_absolute_path "$1")
  if has_param "$path"; then
    path=$(echo "$path" | sed -E 's#/:[^/]+#/{*}#g; s#/\*$#/{**}#')
  fi
  echo "$path"
}
