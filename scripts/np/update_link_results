#!/bin/bash

# Store the normalized route on the link, plus a summary and the endpoint it exposes.
#
# Stored twice: as the action results, which the platform writes onto the link's
# attributes when the action finishes (otherwise it writes the raw parameters back,
# e.g. empty verbs instead of ALL and an empty scope instead of the resolved one),
# and patched on the link right away, so it is readable before the action ends.

set -euo pipefail

: "${AUTH_TYPE:?AUTH_TYPE is required (resolved by build_link_context)}"

ROUTE=$(echo "$ROUTES_JSON" | jq -c '.[0]')

ATTRIBUTES=$(echo "$LINK_ATTRIBUTES_JSON" | jq -c \
  --argjson route "$ROUTE" \
  --arg domain_name "$DOMAIN_NAME" \
  --arg auth_type "$AUTH_TYPE" '
  . + {
    path: $route.path,
    methods: $route.methods,
    groups: $route.groups,
    scope: $route.scope,
    auth_type: $auth_type,
    endpoint: ($domain_name + $route.path),
    summary: (($route.methods | join(", ")) + " | " + $domain_name + $route.path
      + (if ($route.groups | length) > 0 then " | " + ($route.groups | join(", ")) else "" end))
  }')

echo "Storing link $LINK_ID results: $(echo "$ATTRIBUTES" | jq -r '.summary')"
np link action update --results "$ATTRIBUTES"
np link patch --id "$LINK_ID" --body "$(jq -n --argjson attributes "$ATTRIBUTES" '{attributes: $attributes}')"

echo "✅ Link results stored"
