#!/bin/bash

set -euo pipefail

AUTH_TYPE="${AUTH_TYPE:-aws-avp}"

# Compute summary for each route: "METHOD1, METHOD2 | /path | group1, group2"
ROUTES_WITH_SUMMARY=$(echo "${ROUTES_JSON:-[]}" | jq -c '
  map(. + {
    summary: (
      (if (.methods | type) == "array" then .methods | join(", ")
       else (.method // "GET")
       end)
      + " | " + .path
      + (
          (.groups | if type == "array" then join(", ") else (. // "") end) |
          if length > 0 then " | " + . else "" end
        )
    )
  })
')

# Only send the keys this script produces. The notification delivers the
# action parameters snake_cased (publicDomain -> public_domain); echoing them
# back stored both spellings in the action results, and nullplatform's
# snake->camel conversion then throws "Key `privateDomain` would overwrite
# existing key" on every read of the action. The provisioner turns that into
# "Unknown error occurred while calling http endpoint" and marks the action
# failed. The API merges these keys into the results it already holds.
if [[ "$AUTH_TYPE" == "aws-avp" ]]; then
  AVP_POLICY_STORE_ARN="${AVP_POLICY_STORE_ARN:-}"
  RESULTS=$(jq -n \
    --arg avp_policy_store_arn "$AVP_POLICY_STORE_ARN" \
    --argjson routes "$ROUTES_WITH_SUMMARY" \
    '{
      avp_policy_store_arn: $avp_policy_store_arn,
      routes: $routes
    }')

  echo "Storing service results: avp_policy_store_arn=$AVP_POLICY_STORE_ARN"
  np service action update --results "$RESULTS"

  np service patch --id "$SERVICE_ID" \
    --body "{\"attributes\": {\"avp_policy_store_arn\": \"$AVP_POLICY_STORE_ARN\", \"routes\": $ROUTES_WITH_SUMMARY}}"
else
  RESULTS=$(jq -n --argjson routes "$ROUTES_WITH_SUMMARY" '{routes: $routes}')

  echo "Storing service results (aws-cognito)"
  np service action update --results "$RESULTS"

  np service patch --id "$SERVICE_ID" \
    --body "{\"attributes\": {\"routes\": $ROUTES_WITH_SUMMARY}}"
fi

echo "✅ Service results stored"
