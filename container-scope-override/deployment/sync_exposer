#!/bin/bash

# Sync Exposer: runs inside the target scope's deployment workflows (initial,
# blue_green, switch_traffic, finalize, rollback, delete). Backend Service names and
# blue/green weights change during a deploy, so every HTTPRoute pointing at this
# scope is rebuilt by re-running the action that owns it:
#
#   - links (domain + links model): the update action of each active link of this
#     application whose route targets the scope being deployed
#   - legacy services (routes declared inline on the service): the service update
#     action, as before

echo "=== DEBUG: Starting sync_exposer script ==="

APPLICATION_NRN=$(jq -r .application.nrn <<< "$CONTEXT")
SCOPE_SLUG=$(jq -r '.scope.slug // empty' <<< "$CONTEXT")

echo "SERVICE SPECIFICATION SLUG: $SERVICE_SPECIFICATION_SLUG, APPLICATION_NRN: $APPLICATION_NRN, SCOPE_SLUG: $SCOPE_SLUG"

# Create an action on a service or link (retrying while another action is in
# progress) and wait for it to finish.
#   $1 kind: service | link
#   $2 id of the service or link
#   $3 action specification id
#   $4 parameters (JSON)
run_action_and_wait() {
  local kind="$1" entity_id="$2" spec_id="$3" params="$4"
  local id_flag body response action_id="" existing_id status
  local max_create_retries=10 retry_delay=5 create_attempt=0
  local max_iterations=20 iteration=0

  if [[ "$kind" == "service" ]]; then
    id_flag="--serviceId"
  else
    id_flag="--linkId"
  fi

  body=$(jq -n --argjson params "$params" --arg spec_id "$spec_id" \
    '{name: "update", parameters: $params, specification_id: $spec_id}')

  while [[ -z "$action_id" ]]; do
    ((create_attempt++))
    echo "DEBUG: [$kind $entity_id] create attempt $create_attempt/$max_create_retries"

    if [[ "$create_attempt" -gt $max_create_retries ]]; then
      echo "Error: Maximum number of create attempts (${max_create_retries}) reached for $kind $entity_id."
      return 1
    fi

    if [[ "$create_attempt" -gt 1 ]]; then
      sleep "$retry_delay"
    fi

    response=$(np "$kind" action create "$id_flag" "$entity_id" --body "$body" --format json 2>&1 || true)

    if echo "$response" | grep -q "already an action with status.*in_progress"; then
      echo "DEBUG: [$kind $entity_id] action already in progress, looking it up..."
      existing_id=$(np "$kind" action list "$id_flag" "$entity_id" --format json | jq -r --arg spec_id "$spec_id" '
        .results
        | map(select(.specification_id == $spec_id and .status == "in_progress"))
        | .[0].id // empty')
      if [[ -n "$existing_id" ]]; then
        echo "Using existing in_progress action $existing_id"
        action_id="$existing_id"
      fi
    elif echo "$response" | grep -q 'FST_ERR_VALIDATION'; then
      # Validation errors are deterministic: retrying the same payload cannot succeed
      echo "ERROR: [$kind $entity_id] action parameters were rejected by validation: $response"
      return 1
    elif echo "$response" | grep -q '"error"'; then
      echo "ERROR: [$kind $entity_id] failed to create action: $response"
    else
      action_id=$(echo "$response" | jq -r '.id // empty' 2>/dev/null)
      if [[ -z "$action_id" ]]; then
        echo "DEBUG: [$kind $entity_id] could not extract the action id from: $response"
      fi
    fi
  done

  echo "Created endpoint exposer update action[$kind=$entity_id, id=$action_id], waiting for its completion"

  while true; do
    ((iteration++))
    if [[ "$iteration" -gt $max_iterations ]]; then
      echo "Error: Maximum number of iterations (${max_iterations}) reached waiting for $kind $entity_id."
      return 1
    fi

    status=$(np "$kind" action read "$id_flag" "$entity_id" --id "$action_id" --format json | jq -r .status)
    echo "Checking endpoint exposer update action[$kind=$entity_id, id=$action_id, status=$status]"

    if [[ "$status" == "success" ]]; then
      echo "✅ Endpoint exposer successfully updated ($kind $entity_id)"
      return 0
    elif [[ "$status" == "failed" ]]; then
      echo "❌ Could not update endpoint exposer ($kind $entity_id), deployment will be rollbacked"
      return 1
    fi

    sleep 5
  done
}

# Step 1: Get service specification by slug
echo "DEBUG: Fetching service specifications..."
SERVICE_SPECS=$(np service specification list --nrn "$APPLICATION_NRN" --type dependency --format json)
SERVICE_SPEC_ID=$(jq -r --arg slug "$SERVICE_SPECIFICATION_SLUG" '
  .results
  | map(select(.slug == $slug))
  | .[0].id // empty
' <<< "$SERVICE_SPECS")

if [[ -z "$SERVICE_SPEC_ID" ]]; then
  echo "Error: Could not find service specification with slug '$SERVICE_SPECIFICATION_SLUG'"
  exit 1
fi

echo "DEBUG: SERVICE_SPEC_ID=$SERVICE_SPEC_ID"

SYNCED=0

# Step 2: Links of this application that expose a path served by this scope
echo "DEBUG: Fetching links for application..."
LINKS=$(np link list --nrn "$APPLICATION_NRN" --status active --limit 200 --format json | jq -c '.results // []')

while IFS= read -r LINK; do
  [[ -z "$LINK" ]] && continue
  LINK_ID=$(jq -r .id <<< "$LINK")
  LINK_SCOPE=$(jq -r '.attributes.scope // empty' <<< "$LINK")

  if [[ -n "$SCOPE_SLUG" && "$LINK_SCOPE" != "$SCOPE_SLUG" ]]; then
    continue
  fi

  LINK_SERVICE_ID=$(jq -r .service_id <<< "$LINK")
  LINK_SERVICE_SPEC_ID=$(np service read --id "$LINK_SERVICE_ID" --format json | jq -r '.specification_id // empty')
  if [[ "$LINK_SERVICE_SPEC_ID" != "$SERVICE_SPEC_ID" ]]; then
    continue
  fi

  LINK_SPEC_ID=$(jq -r .specification_id <<< "$LINK")
  LINK_ACTION_SPEC_ID=$(np link specification action specification list \
    --link-specification-id "$LINK_SPEC_ID" --format json | jq -r '
    .results
    | map(select(.type == "update" or (.slug | startswith("update"))))
    | .[0].id // empty')

  if [[ -z "$LINK_ACTION_SPEC_ID" ]]; then
    echo "Error: Could not find the update action specification of link specification '$LINK_SPEC_ID'"
    exit 1
  fi

  # endpoint and summary are outputs of the link action, not inputs
  LINK_PARAMETERS=$(jq -c '.attributes | del(.endpoint, .summary)' <<< "$LINK")

  echo "Syncing link $LINK_ID (scope $LINK_SCOPE) of service $LINK_SERVICE_ID"
  run_action_and_wait link "$LINK_ID" "$LINK_ACTION_SPEC_ID" "$LINK_PARAMETERS" || exit 1
  ((SYNCED++))
done < <(jq -c '.[]' <<< "$LINKS")

# Step 3: Legacy services of this application (routes declared inline)
echo "DEBUG: Fetching services for application..."
SERVICES=$(np service list --nrn "$APPLICATION_NRN" --format json)

LEGACY_SERVICE_IDS=$(jq -r --arg spec_id "$SERVICE_SPEC_ID" '
  .results[]
  | select(.specification_id == $spec_id and .status == "active")
  | .id
' <<< "$SERVICES")

for SERVICE_ID in $LEGACY_SERVICE_IDS; do
  SERVICE_DATA=$(np service read --id "$SERVICE_ID" --format json)
  IS_LEGACY=$(jq -r '
    ((.attributes.domain_name // "") == "") and (((.attributes.routes // []) | length) > 0)
  ' <<< "$SERVICE_DATA")

  if [[ "$IS_LEGACY" != "true" ]]; then
    continue
  fi

  PARAMETERS=$(jq -c .attributes <<< "$SERVICE_DATA")

  ACTION_SLUG="update-$SERVICE_SPECIFICATION_SLUG"
  SERVICE_ACTION_SPEC_ID=$(np service specification action specification list \
    --serviceSpecificationId "$SERVICE_SPEC_ID" --format json | jq -r --arg slug "$ACTION_SLUG" '
    .results
    | map(select(.slug == $slug))
    | .[0].id // empty')

  if [[ -z "$SERVICE_ACTION_SPEC_ID" ]]; then
    echo "Error: Could not find action specification with slug '$ACTION_SLUG' for service specification '$SERVICE_SPEC_ID'"
    exit 1
  fi

  echo "Syncing legacy service $SERVICE_ID"
  run_action_and_wait service "$SERVICE_ID" "$SERVICE_ACTION_SPEC_ID" "$PARAMETERS" || exit 1
  ((SYNCED++))
done

if [[ "$SYNCED" -eq 0 ]]; then
  echo "No links or services of '$SERVICE_SPECIFICATION_SLUG' route to this scope, skipping exposer sync"
fi

echo "=== DEBUG: sync_exposer script completed successfully ==="
