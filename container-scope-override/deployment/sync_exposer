#!/bin/bash

# Runs inside the scope's deploy workflows (blue_green, switch_traffic,
# finalize, rollback, initial, delete). Re-runs `update` on every endpoint
# exposer of the application that routes to the scope being deployed, so their
# HTTPRoutes follow the scope's Kubernetes services. A failure fails the deploy
# step: the exposer routes would otherwise point at the wrong backend.

echo "=== Starting sync_exposer ==="

APPLICATION_NRN=$(jq -r .application.nrn <<< "$CONTEXT")
DEPLOYED_SCOPE_ID=$(jq -r '.scope.id // "" | tostring' <<< "$CONTEXT")
DEPLOYED_SCOPE_SLUG=$(jq -r '.scope.slug // ""' <<< "$CONTEXT")
if [[ -z "$DEPLOYED_SCOPE_SLUG" && -n "$DEPLOYED_SCOPE_ID" ]]; then
  DEPLOYED_SCOPE_SLUG=$(np scope read --id "$DEPLOYED_SCOPE_ID" --format json | jq -r '.slug // ""')
fi

# values.yaml ships the slug the spec gets when registered from this repo
# ("http-route-access-control"). Installations that registered it under another
# name (e.g. "endpoint-exposer") set EXPOSER_SERVICE_SPECIFICATION_SLUG in the
# agent environment; values.yaml configuration would otherwise shadow it.
SERVICE_SPECIFICATION_SLUG="${EXPOSER_SERVICE_SPECIFICATION_SLUG:-$SERVICE_SPECIFICATION_SLUG}"

# Each update renders the exposer's routes, which takes a few seconds per scope.
ACTION_TIMEOUT_SECONDS="${EXPOSER_SYNC_TIMEOUT_SECONDS:-600}"
POLL_SECONDS="${EXPOSER_SYNC_POLL_SECONDS:-5}"

echo "Spec: $SERVICE_SPECIFICATION_SLUG, application: $APPLICATION_NRN, scope: ${DEPLOYED_SCOPE_SLUG:-unknown}"

SERVICE_SPEC_ID=$(np service specification list --nrn "$APPLICATION_NRN" --type dependency --format json \
  | jq -r --arg slug "$SERVICE_SPECIFICATION_SLUG" 'first(.results[] | select(.slug == $slug) | .id) // ""')

# This override runs on every deploy of the scope, including apps that never
# installed the exposer. A missing spec means there is nothing to sync, not a
# failed deploy.
if [[ -z "$SERVICE_SPEC_ID" ]]; then
  echo "No service specification with slug '$SERVICE_SPECIFICATION_SLUG' visible to $APPLICATION_NRN, skipping exposer sync"
  exit 0
fi

UPDATE_ACTION_SPEC_ID=$(np service specification action specification list --serviceSpecificationId "$SERVICE_SPEC_ID" --format json \
  | jq -r --arg slug "update-$SERVICE_SPECIFICATION_SLUG" 'first(.results[] | select(.slug == $slug) | .id) // ""')
if [[ -z "$UPDATE_ACTION_SPEC_ID" ]]; then
  echo "Error: no action specification 'update-$SERVICE_SPECIFICATION_SLUG' for service specification $SERVICE_SPEC_ID"
  exit 1
fi

# Exposers of the application that route to the deployed scope (all of them
# when the scope isn't known).
EXPOSERS=$(np service list --nrn "$APPLICATION_NRN" --specification-id "$SERVICE_SPEC_ID" --all --format json \
  | jq -c --arg spec "$SERVICE_SPEC_ID" --arg scope "$DEPLOYED_SCOPE_SLUG" '
      [.results[]
        | select(.specification_id == $spec)
        | select($scope == "" or ([.attributes.routes[]?.scope] | index($scope)))]')

if [[ "$(jq 'length' <<< "$EXPOSERS")" -eq 0 ]]; then
  echo "No endpoint exposer routes to this scope, skipping exposer sync"
  exit 0
fi

# An update action is rejected unless the service's create succeeded, so only
# active instances can be synced; the rest are reported, not retried.
jq -r '.[] | select(.status != "active") | "Skipping endpoint exposer \(.name) [\(.id)] (status=\(.status)): only active services can be updated"' <<< "$EXPOSERS"

# wait_for_action SERVICE_ID ACTION_ID -> final status
wait_for_action() {
  local service_id="$1" action_id="$2" status="" waited=0
  while (( waited < ACTION_TIMEOUT_SECONDS )); do
    status=$(np service action read --serviceId "$service_id" --id "$action_id" --format json | jq -r '.status // ""')
    case "$status" in
      success|failed|cancelled) echo "$status"; return 0 ;;
    esac
    sleep "$POLL_SECONDS"
    waited=$((waited + POLL_SECONDS))
  done
  echo "timeout"
}

sync_service() {
  local service_id="$1" name="$2" parameters pending action_id status

  # An action already pending or in progress may have read the Kubernetes
  # services before this deploy step changed them: let it finish, then run a
  # fresh update.
  pending=$(np service action list --serviceId "$service_id" --format json \
    | jq -r '[.results[] | select(.status == "pending" or .status == "in_progress") | .id] | .[]')
  for action_id in $pending; do
    echo "Waiting for action $action_id of $name to finish before syncing..."
    wait_for_action "$service_id" "$action_id" >/dev/null
  done

  # The routes as the user declared them; build_context recomputes the derived
  # fields (visibility, summary).
  parameters=$(np service read --id "$service_id" --format json \
    | jq -c '{routes: [(.attributes.routes // [])[] | del(.visibility, .summary)]}')
  [[ -z "$parameters" ]] && parameters='{}'

  action_id=$(np service action create --serviceId "$service_id" \
    --body "$(jq -nc --argjson params "$parameters" --arg spec_id "$UPDATE_ACTION_SPEC_ID" \
      '{name: "update", parameters: $params, specification_id: $spec_id}')" \
    --format json | jq -r '.id // ""')
  if [[ -z "$action_id" ]]; then
    echo "❌ Could not create an update action for endpoint exposer $name [$service_id]"
    return 1
  fi

  echo "Created update action $action_id for endpoint exposer $name, waiting for it..."
  status=$(wait_for_action "$service_id" "$action_id")
  if [[ "$status" != "success" ]]; then
    echo "❌ Update action $action_id of endpoint exposer $name ended $status"
    return 1
  fi
  echo "✅ Endpoint exposer $name updated"
}

FAILED=()
while IFS=$'\t' read -r SERVICE_ID SERVICE_NAME; do
  [[ -z "$SERVICE_ID" ]] && continue
  if ! sync_service "$SERVICE_ID" "$SERVICE_NAME"; then
    FAILED+=("$SERVICE_NAME [$SERVICE_ID]")
  fi
done < <(jq -r '.[] | select(.status == "active") | [.id, .name] | @tsv' <<< "$EXPOSERS")

if [[ ${#FAILED[@]} -gt 0 ]]; then
  echo "❌ Could not update endpoint exposer(s): ${FAILED[*]}"
  exit 1
fi

echo "=== sync_exposer completed ==="
