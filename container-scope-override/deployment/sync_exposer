#!/bin/bash

# Runs inside the scope's deploy workflows (blue_green, switch_traffic,
# finalize, rollback, initial, delete). Re-runs `update` on every endpoint
# exposer of the application that routes to the scope being deployed, so their
# HTTPRoutes follow the scope's Kubernetes services. A failure fails the deploy
# step: the exposer routes would otherwise point at the wrong backend.
#
# Two kinds of exposers own HTTPRoutes:
#   - links (domain + links model): the update action of each active link of the
#     application with a route that targets the deployed scope
#   - legacy services (routes declared inline on the service): the service's
#     update action

# The body is a function so the early outs can `return`: the np CLI ends the
# whole workflow when a step script calls `exit 0`, skipping the steps after it.
main() {
  echo "=== Starting sync_exposer ==="

  APPLICATION_NRN=$(jq -r .application.nrn <<< "$CONTEXT")
  DEPLOYED_SCOPE_ID=$(jq -r '.scope.id // "" | tostring' <<< "$CONTEXT")
  DEPLOYED_SCOPE_SLUG=$(jq -r '.scope.slug // ""' <<< "$CONTEXT")
  if [[ -z "$DEPLOYED_SCOPE_SLUG" && -n "$DEPLOYED_SCOPE_ID" ]]; then
    DEPLOYED_SCOPE_SLUG=$(np scope read --id "$DEPLOYED_SCOPE_ID" --format json | jq -r '.slug // ""')
  fi

  # values.yaml ships the slug the spec gets when registered from this repo
  # ("http-route-access-control"). Installations that registered it under another
  # name (e.g. "endpoint-exposer") set EXPOSER_SERVICE_SPECIFICATION_SLUG in the
  # agent environment; values.yaml configuration would otherwise shadow it.
  SERVICE_SPECIFICATION_SLUG="${EXPOSER_SERVICE_SPECIFICATION_SLUG:-$SERVICE_SPECIFICATION_SLUG}"

  # Each update renders the exposer's routes, which takes a few seconds per scope.
  ACTION_TIMEOUT_SECONDS="${EXPOSER_SYNC_TIMEOUT_SECONDS:-600}"
  POLL_SECONDS="${EXPOSER_SYNC_POLL_SECONDS:-5}"

  echo "Spec: $SERVICE_SPECIFICATION_SLUG, application: $APPLICATION_NRN, scope: ${DEPLOYED_SCOPE_SLUG:-unknown}"

  SERVICE_SPEC_ID=$(np service specification list --nrn "$APPLICATION_NRN" --type dependency --format json \
    | jq -r --arg slug "$SERVICE_SPECIFICATION_SLUG" 'first(.results[] | select(.slug == $slug) | .id) // ""')

  # This override runs on every deploy of the scope, including apps that never
  # installed the exposer. A missing spec means there is nothing to sync, not a
  # failed deploy.
  if [[ -z "$SERVICE_SPEC_ID" ]]; then
    echo "No service specification with slug '$SERVICE_SPECIFICATION_SLUG' visible to $APPLICATION_NRN, skipping exposer sync"
    return 0
  fi

  UPDATE_ACTION_SPEC_ID=$(np service specification action specification list --serviceSpecificationId "$SERVICE_SPEC_ID" --format json \
    | jq -r --arg slug "update-$SERVICE_SPECIFICATION_SLUG" 'first(.results[] | select(.slug == $slug) | .id) // ""')
  if [[ -z "$UPDATE_ACTION_SPEC_ID" ]]; then
    echo "Error: no action specification 'update-$SERVICE_SPECIFICATION_SLUG' for service specification $SERVICE_SPEC_ID"
    exit 1
  fi

  # Exposers of the application that route to the deployed scope (all of them
  # when the scope isn't known).
  # Only --nrn: the np CLI in the controlplane-agent image (aws-0.7.0) rejects
  # --specification-id, and an empty list here would silently skip the sync.
  # The jq filter keeps only this spec's services.
  if ! SERVICES=$(np service list --nrn "$APPLICATION_NRN" --format json); then
    echo "Error: could not list the services of $APPLICATION_NRN"
    exit 1
  fi
  # Legacy services only: a domain service holds no routes of its own, its links do.
  EXPOSERS=$(jq -c --arg spec "$SERVICE_SPEC_ID" --arg scope "$DEPLOYED_SCOPE_SLUG" '
        [.results[]
          | select(.specification_id == $spec)
          | select((.attributes.domain_name // "") == "")
          | select($scope == "" or ([.attributes.routes[]?.scope] | index($scope)))]' <<< "$SERVICES")

  # Links of the application on this spec's services with a route on the deployed
  # scope. Every route stores its resolved scope; links created before the routes
  # list kept a single one at the top level.
  if ! LINKS=$(np link list --nrn "$APPLICATION_NRN" --format json); then
    echo "Error: could not list the links of $APPLICATION_NRN"
    exit 1
  fi
  DOMAIN_SERVICE_IDS=$(jq -c --arg spec "$SERVICE_SPEC_ID" \
    '[.results[] | select(.specification_id == $spec and (.attributes.domain_name // "") != "") | .id]' <<< "$SERVICES")
  LINKS=$(jq -c --argjson services "$DOMAIN_SERVICE_IDS" --arg scope "$DEPLOYED_SCOPE_SLUG" '
        [(.results // [])[]
          | select(.service_id as $id | $services | index($id))
          | select(.status != "deleted")
          | select($scope == "" or ([.attributes.routes[]?.scope, .attributes.scope] | index($scope)))]' \
    <<< "${LINKS:-"{}"}")

  if [[ "$(jq 'length' <<< "$EXPOSERS")" -eq 0 && "$(jq 'length' <<< "$LINKS")" -eq 0 ]]; then
    echo "No endpoint exposer routes to this scope, skipping exposer sync"
    return 0
  fi

  # An update action is rejected unless the create succeeded, so only active
  # services and links can be synced; the rest are reported, not retried.
  jq -r '.[] | select(.status != "active") | "Skipping endpoint exposer \(.name) [\(.id)] (status=\(.status)): only active services can be updated"' <<< "$EXPOSERS"
  jq -r '.[] | select(.status != "active") | "Skipping endpoint exposer link \(.name) [\(.id)] (status=\(.status)): only active links can be updated"' <<< "$LINKS"

  # wait_for_action KIND ID ACTION_ID -> final status (KIND: service | link)
  wait_for_action() {
    local kind="$1" id="$2" action_id="$3" status="" waited=0
    while (( waited < ACTION_TIMEOUT_SECONDS )); do
      status=$(np "$kind" action read "--${kind}Id" "$id" --id "$action_id" --format json | jq -r '.status // ""')
      case "$status" in
        success|failed|cancelled) echo "$status"; return 0 ;;
      esac
      sleep "$POLL_SECONDS"
      waited=$((waited + POLL_SECONDS))
    done
    echo "timeout"
  }

  # sync KIND ID NAME ACTION_SPEC_ID PARAMETERS
  sync() {
    local kind="$1" id="$2" name="$3" action_spec_id="$4" parameters="$5" pending action_id status

    # An action already pending or in progress may have read the Kubernetes
    # services before this deploy step changed them: let it finish, then run a
    # fresh update.
    pending=$(np "$kind" action list "--${kind}Id" "$id" --format json \
      | jq -r '[.results[] | select(.status == "pending" or .status == "in_progress") | .id] | .[]')
    for action_id in $pending; do
      echo "Waiting for action $action_id of $name to finish before syncing..."
      wait_for_action "$kind" "$id" "$action_id" >/dev/null
    done

    action_id=$(np "$kind" action create "--${kind}Id" "$id" \
      --body "$(jq -nc --argjson params "$parameters" --arg spec_id "$action_spec_id" \
        '{name: "update", parameters: $params, specification_id: $spec_id}')" \
      --format json | jq -r '.id // ""')
    if [[ -z "$action_id" ]]; then
      echo "❌ Could not create an update action for endpoint exposer $name [$id]"
      return 1
    fi

    echo "Created update action $action_id for endpoint exposer $name, waiting for it..."
    status=$(wait_for_action "$kind" "$id" "$action_id")
    if [[ "$status" != "success" ]]; then
      echo "❌ Update action $action_id of endpoint exposer $name ended $status"
      return 1
    fi
    echo "✅ Endpoint exposer $name updated"
  }

  FAILED=()

  while IFS=$'\t' read -r SERVICE_ID SERVICE_NAME; do
    [[ -z "$SERVICE_ID" ]] && continue
    # The routes as the user declared them; build_context recomputes the derived
    # fields (visibility, summary).
    PARAMETERS=$(np service read --id "$SERVICE_ID" --format json \
      | jq -c '{routes: [(.attributes.routes // [])[] | del(.visibility, .summary)]}')
    [[ -z "$PARAMETERS" ]] && PARAMETERS='{}'
    if ! sync service "$SERVICE_ID" "$SERVICE_NAME" "$UPDATE_ACTION_SPEC_ID" "$PARAMETERS"; then
      FAILED+=("$SERVICE_NAME [$SERVICE_ID]")
    fi
  done < <(jq -r '.[] | select(.status == "active") | [.id, .name] | @tsv' <<< "$EXPOSERS")

  while IFS= read -r LINK; do
    [[ -z "$LINK" ]] && continue
    LINK_ID=$(jq -r .id <<< "$LINK")
    LINK_NAME="link $(jq -r '.name // .slug // .id' <<< "$LINK")"

    LINK_ACTION_SPEC_ID=$(np link specification action specification list \
      --linkSpecificationId "$(jq -r .specification_id <<< "$LINK")" --format json | jq -r '
      first(.results[] | select(.type == "update" or (.slug | startswith("update"))) | .id) // ""')
    if [[ -z "$LINK_ACTION_SPEC_ID" ]]; then
      echo "❌ No update action specification for $LINK_NAME [$LINK_ID]"
      FAILED+=("$LINK_NAME [$LINK_ID]")
      continue
    fi

    # The routes as the user declared them; build_link_context recomputes the
    # derived fields (endpoints, summaries, auth_type). Links created before the
    # routes list kept a single path at the top level, which the update action
    # rejects ("must have required property 'routes'"): send it as a one-route list.
    PARAMETERS=$(jq -c '.attributes
      | if .routes then . else
          {routes: [{path, methods, scope, groups} | with_entries(select(.value != null))]}
          + del(.path, .methods, .scope, .groups)
        end
      | del(.endpoint, .endpoints, .summary, .auth_type)
      | .routes |= map(del(.summary))' <<< "$LINK")
    if ! sync link "$LINK_ID" "$LINK_NAME" "$LINK_ACTION_SPEC_ID" "$PARAMETERS"; then
      FAILED+=("$LINK_NAME [$LINK_ID]")
    fi
  done < <(jq -c '.[] | select(.status == "active")' <<< "$LINKS")

  if [[ ${#FAILED[@]} -gt 0 ]]; then
    echo "❌ Could not update endpoint exposer(s): ${FAILED[*]}"
    exit 1
  fi

  echo "=== sync_exposer completed ==="
}

main "$@"
